# =========================================================
# CredSure - repository-wide ignore rules
# (frontend/.gitignore adds Vite-specific rules)
# =========================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
pip-wheel-metadata/

# Virtual environments
venv/
.venv/
env/
ENV/

# Test / coverage / tool caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
.mypy_cache/
.ruff_cache/
.tox/
.hypothesis/

# ---------- Environment & secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.der
id_ed25519*
# Issuer private keys: ignore everything in backend/keys except its README (platform/ and
# synthetic/<profile>/ key directories included).
backend/keys/*
!backend/keys/README.md
secrets/

# ---------- Node / frontend ----------
node_modules/
frontend/dist/
frontend/dist-ssr/
*.tsbuildinfo
.vite/
.vitest/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Local SQLite database ----------
backend/data/*
!backend/data/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------- Generated datasets ----------
data/generated/*
!data/generated/.gitkeep

# ---------- Logs ----------
logs/
*.log

# ---------- Editors / OS ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
