# CredSure backend configuration.
# Copy to backend/.env and adjust. Never commit the real .env file.
# Every variable is optional; defaults are defined in app/core/config.py.

CREDSURE_APP_NAME=CredSure
CREDSURE_ENVIRONMENT=development
CREDSURE_DEBUG=false
CREDSURE_LOG_LEVEL=INFO

# SQLite database. Default: backend/data/credsure.db (absolute path resolved at runtime).
# CREDSURE_DATABASE_URL=sqlite:///C:/path/to/backend/data/credsure.db
CREDSURE_DATABASE_ECHO=false

# Comma-separated origins allowed by CORS (Vite dev server).
CREDSURE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ed25519 signing-key directories (git-ignored; see backend/keys/README.md, ADR-005, ADR-024).
# Defaults: backend/keys/platform and backend/keys/synthetic (per-profile subfolders).
# Never put private keys themselves in this file.
# CREDSURE_SIGNING_KEY_DIR=C:/path/to/backend/keys/platform
# CREDSURE_SYNTHETIC_KEY_DIR=C:/path/to/backend/keys/synthetic
